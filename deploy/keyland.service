[Unit]
Description=Keyland Network router panel and engine
After=NetworkManager.service ModemManager.service network-online.target
Wants=NetworkManager.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/opt/keyland
EnvironmentFile=/etc/keyland/keyland.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/keyland/.venv/bin/uvicorn keyland.main:app --host 127.0.0.1 --port ${KEYLAND_PORT}
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=25
RuntimeDirectory=keyland
RuntimeDirectoryMode=0700
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
