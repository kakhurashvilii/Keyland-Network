[Unit]
Description=Restore persistent Keyland Router Mode
After=NetworkManager.service ModemManager.service
Wants=NetworkManager.service
ConditionPathExists=/etc/keyland/router-autostart.json

[Service]
Type=oneshot
# Keep hostapd and dnsmasq alive after the restore helper exits.
KillMode=process
RemainAfterExit=no
ExecStart=/usr/local/sbin/keyland-routerctl --restore
TimeoutStartSec=60
