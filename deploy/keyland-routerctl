#!/usr/bin/env python3
"""Narrow JSON stdin/stdout bridge for privileged Keyland router operations."""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

configured_root = os.environ.get("KEYLAND_HOME")
if configured_root:
    PROJECT_ROOT = Path(configured_root)
elif Path("/opt/keyland").is_dir():
    PROJECT_ROOT = Path("/opt/keyland")
else:
    # Support manual installs that keep the router package under /usr/local/lib.
    PROJECT_ROOT = Path("/usr/local/lib/keyland-router")
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))

from keyland.adapters.wifi import router


def main() -> int:
    try:
        request = json.load(sys.stdin)
        if not isinstance(request, dict):
            raise ValueError("Request must be a JSON object.")
        action = request.get("action")
        payload = request.get("payload") or {}
        if not isinstance(payload, dict):
            raise ValueError("Payload must be a JSON object.")

        handlers = {
            "status": lambda: router.status(),
            "prepare": lambda: router.prepare_ap(payload),
            "start": lambda: router.start(payload),
            "stop": lambda: router.stop(payload.get("confirmed") is True),
            "clients": lambda: router.client_status(),
            "client_block": lambda: router.client_block(
                payload.get("mac", ""), payload.get("blocked") is True
            ),
            "client_limit": lambda: router.client_limit(
                payload.get("mac", ""),
                int(payload.get("download_mbps", 0)),
                int(payload.get("upload_mbps", 0)),
            ),
        }
        if action not in handlers:
            raise ValueError("Unsupported router action.")
        result = handlers[action]()
        print(json.dumps(result, ensure_ascii=False, separators=(",", ":")))
        return 0
    except Exception as exc:
        print(json.dumps({"success": False, "error": str(exc)}, ensure_ascii=False))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
